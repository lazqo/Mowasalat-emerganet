{
  "expo": {
    "name": "Wenak",
    "slug": "wenak",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wenak",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "jo.wenak.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "يستخدم وينك موقعك على جهازك فقط لحساب مكانك على خط الباص. لا يتم إرسال إحداثياتك إلى الخادم.",
        "CFBundleDisplayName": "وينك"
      }
    },
    "android": {
      "package": "jo.wenak.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#586A45"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#586A45"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستخدم وينك موقعك على جهازك فقط لحساب مكانك على خط الباص. لا يتم إرسال إحداثياتك إلى الخادم.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/feather"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
