# Copy to backend/.env for local development. In hosting, set these as secrets.
APP_ENV=development                 # production => strict CORS, no docs, no dev OTP codes

# Durable configuration/account data ONLY (drivers, aggregate demand counters)
MONGO_URL=mongodb://localhost:27017
DB_NAME=wenak

# Realtime TTL state (trips, waits, sessions, OTP, rate limits). Managed Redis in production.
REDIS_URL=redis://localhost:6379/0
# ALLOW_INMEMORY_STATE=1            # dev only: fake in-process Redis when REDIS_URL is unset

# OTP delivery: mock (dev) | twilio (Phase 3). Twilio secrets are read from env only.
OTP_PROVIDER=mock

# HTTP
CORS_ORIGINS=                       # comma-separated web origins; empty = none in production
ADMIN_TOKEN=                        # empty disables /api/admin/*
TRUST_PROXY_HEADERS=1               # read X-Forwarded-For behind the platform proxy
